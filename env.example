# Copy to .env and fill in. Never commit .env (gitignored).

# Required: HMAC key for signed session cookies + CSRF tokens, >=32 chars.
KERDOOS_SESSION_SECRET=

# SQLite paths -- default to the Docker image's /data volume, no need to set
# these for a compose deployment.
# KERDOOS_CONFIG_DB=/data/config.db
# KERDOOS_STATE_DB=/data/state.db

# Set to "false" only for a plain-http LAN deployment (no TLS terminator).
KERDOOS_COOKIE_SECURE=true

# Reverse proxies trusted to set X-Forwarded-For / X-Forwarded-Proto.
# Honoured by the Docker image's CMD only: a bare `uvicorn` launch outside
# the image does not read it (pass --no-proxy-headers, or --proxy-headers
# --forwarded-allow-ips, yourself there).
# Unset or empty (the default): no forwarding header is ever trusted, and
# every request behind a proxy appears to come from the proxy itself, so the
# access log sees one single address. Set it to the address(es) your reverse
# proxy connects FROM, as seen inside the container (comma-separated IPs or
# CIDR networks). With the compose port mapping, a proxy running on the
# Docker host arrives through the bridge network's gateway (`docker network
# inspect`), not 127.0.0.1. Any address listed here can forge the client IP,
# including any other local process reaching the published port the same
# way: keep the list no wider than the proxy. An entry naming far more than
# a proxy is REFUSED at startup: the container exits 64 instead of starting
# wide open. Refused are "*" and any network wider than a /8, in every
# spelling (`0.0.0.0/0`, `0.0.0.0/00`, `0.0.0.0/0.0.0.0`, and halves that
# cover the space between them such as `0.0.0.0/1,128.0.0.0/1`). The two
# private ranges an operator may legitimately name, 10.0.0.0/8 and fd00::/8,
# are exactly at the limit and still accepted; fc00::/7 is not, so name the
# assigned half fd00::/8 instead (RFC 4193 leaves fc00::/8 unassigned, so
# nothing is lost).
# Under `restart: unless-stopped` a refusal shows up only as
# "Restarting (64)": the reason, with the offending entry, is in the
# container logs.
#
# The proxy must OVERWRITE X-Forwarded-Proto and APPEND to X-Forwarded-For,
# never pass either through as the client sent it. In nginx:
#   proxy_set_header X-Forwarded-Proto $scheme;
#   proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
# Without the overwrite a client picks its own scheme, and the slash
# redirect (the one absolute URL the app generates) can be downgraded.
# KERDOOS_FORWARDED_ALLOW_IPS=

# MCP server (Model Context Protocol), served in the same process as the
# WebUI at <KERDOOS_PUBLIC_URL>/mcp. Off by default. Turning it on REQUIRES
# KERDOOS_PUBLIC_URL too: without it the WebUI itself refuses to start
# (uvicorn exits 1 on a RuntimeError naming the variable), on purpose, since
# there is no sensible default for the URL clients use. Clients send a bearer
# token created on the WebUI profile page. A request carrying an Origin
# header is refused with 403, whatever its value: browser-based clients are
# not supported.
KERDOOS_MCP_ENABLED=false

# The URL MCP clients use to reach Kerdoos, as the CLIENT sees it (scheme,
# host, optional port and path), typically the reverse proxy's public URL.
# Not the same question as KERDOOS_FORWARDED_ALLOW_IPS above: that one says
# WHICH proxy is trusted, this one says WHICH URL the client sees. The Host
# header allowlist is derived from it (the host, alone and with its port): a
# request whose Host header is not on the list gets 421. The path may only
# contain letters, digits and "/-._~", anything else is refused at startup.
# A plain http:// value is accepted but logs a startup WARNING, since bearer
# tokens then travel unencrypted.
KERDOOS_PUBLIC_URL=

# Extra Host header values accepted on top of those derived from
# KERDOOS_PUBLIC_URL, comma-separated (for instance when the same deployment
# is also reached under a second name). Any wildcard, "*" or "name:*", is
# refused at startup.
KERDOOS_MCP_ALLOWED_HOSTS=

# Bound the MCP sessions this process keeps, so a single token holder cannot
# pin the memory it shares with the WebUI. Past MAX_SESSIONS open sessions, a
# new one gets 503 while the WebUI keeps answering; a session idle for
# IDLE_TIMEOUT_SECONDS is closed and frees its slot. An invalid value falls
# back to the default with a WARNING. Sessions live in a single process:
# keep KERDOOS_WORKERS=1 with MCP on (a startup WARNING is logged otherwise,
# and a client whose request lands on another worker loses its session).
KERDOOS_MCP_MAX_SESSIONS=32
KERDOOS_MCP_SESSION_IDLE_TIMEOUT_SECONDS=300

# /login brute-force rate limit, persisted per typed identifier (never
# resolved to an owner -- anti-enumeration). Known tradeoff: a third party
# who knows (or guesses) an identifier can lock it out for the window.
# MAX_ATTEMPTS=0 disables the limiter entirely (logs a startup WARNING).
KERDOOS_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
KERDOOS_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
# Bounds the tracked-identifier table's STORAGE only -- never decides an
# authentication outcome. Past this many rows, admitting a new identifier
# evicts the oldest tracked row instead of growing unbounded; an
# identifier with no row of its own is NEVER blocked by this cap.
KERDOOS_LOGIN_RATE_LIMIT_ROW_CAP=100000

# Real uvicorn worker count (see the Dockerfile CMD) AND the digest
# evaluator's workers>1 guard read this SAME value. Leave at 1 unless you
# have also disabled KERDOOS_DIGEST_EVALUATOR_ENABLED and switched to an
# external cron calling `kerdoos digest`.
KERDOOS_WORKERS=1
KERDOOS_DIGEST_EVALUATOR_ENABLED=true

# SMTP relay for digest emails. Leave KERDOOS_SMTP_HOST unset to fall back to
# a log-only sender (no mail actually sent). The relay itself must refuse to
# deliver to private/reserved IP ranges (RFC 1918, 127/8, 169.254/16, and the
# IPv6 equivalents) -- a stored recipient address is validated against an
# IP-literal domain, but a PUBLIC domain can still resolve to an internal IP
# (e.g. 10.0.0.1.nip.io), which no email-address validation can catch.
KERDOOS_SMTP_HOST=
KERDOOS_SMTP_PORT=587
KERDOOS_SMTP_FROM=
KERDOOS_SMTP_USERNAME=
KERDOOS_SMTP_PASSWORD=
KERDOOS_SMTP_USE_TLS=true
# Per-operation smtplib socket timeout; must stay below the reaper timeout.
KERDOOS_SMTP_TIMEOUT_SECONDS=30
# Bounded retry on a TRANSIENT send failure (e.g. greylisting), inside the
# same send() call -- never across ticks. Budget-capped by the reaper timeout.
KERDOOS_SMTP_RETRY_ATTEMPTS=2
KERDOOS_SMTP_RETRY_BACKOFF_SECONDS=2

# Max seconds a job_run may sit queued/running before the reaper reclaims it.
KERDOOS_DIGEST_REAPER_TIMEOUT_SECONDS=300

# Max Chromium processes alive at once (browser tier patchright + uc tier
# seleniumbase share ONE gate). Bounded across every process sharing the
# SAME lock directory (the WebUI/`kerdoos digest` use the directory of
# KERDOOS_STATE_DB, i.e. /data in the image; a manual `kerdoos run --db
# <path>` uses the parent of that --db path instead -- point it at /data
# too if it must share the bound with the WebUI). File lock is fcntl --
# Windows has no fcntl, so there the bound is PER PROCESS ONLY (KERDOOS_WORKERS
# x this value), not global; adjust to your machine's available RAM.
# The camoufox tier shares this SAME gate, and it is the expensive one:
# MEASURED peak 1220-1258 MB per fetch against 642-652 MB for Chromium,
# about 1.9x, held only for the duration of the fetch. Sizing at 1 means one
# browser fetch at a time across all tiers; raising it multiplies the peak by
# the value, so budget roughly 1.3 GB per concurrent camoufox fetch.
KERDOOS_BROWSER_MAX_CONCURRENT=1
# Max seconds a fetch waits for the gate above before failing as a
# (retryable) INDETERMINATE source instead of blocking forever.
KERDOOS_BROWSER_ACQUIRE_TIMEOUT_SECONDS=120

# Max seconds the uc tier's Chrome LAUNCH ITSELF may take before it is
# abandoned as a (retryable) INDETERMINATE source -- distinct from the gate
# wait above, which only bounds queuing for the gate, not the launch it
# eventually runs.
KERDOOS_UC_LAUNCH_TIMEOUT_SECONDS=30

# Same as above, for the browser tier's Chromium LAUNCH ITSELF (patchright).
KERDOOS_BROWSER_LAUNCH_TIMEOUT_SECONDS=20

# Delay (seconds) of the uc tier's second orphan-process sweep, which runs
# SYNCHRONOUSLY, still HOLDING the browser gate, on a launch that exceeded
# KERDOOS_UC_LAUNCH_TIMEOUT_SECONDS above -- catches a process spawned AFTER
# the first cleanup pass by a launch that never returns. This prolongs how
# long a single timed-out launch occupies the gate: a value combined with
# KERDOOS_UC_LAUNCH_TIMEOUT_SECONDS that would reach
# KERDOOS_BROWSER_ACQUIRE_TIMEOUT_SECONDS is clamped down with a warning.
# Above KERDOOS_BROWSER_MAX_CONCURRENT=1, this sweep only matches by launch
# marker (never by PID diff, which needs exclusive gate ownership to stay
# safe) -- a uc_driver sibling spawned very late by an abandoned launch can
# then stay orphaned; a known, accepted residual above the single-Chromium
# default.
KERDOOS_UC_ORPHAN_SWEEP_DELAY_SECONDS=5

# Max seconds the browser tier's WHOLE launch-to-close cycle may take
# (launch, new_page, stealth, navigation, reading the page, closing) --
# distinct from the launch-only bound above, which does not cover a
# Chromium that freezes AFTER a successful launch. Keep this above launch +
# navigation with margin, and below KERDOOS_BROWSER_ACQUIRE_TIMEOUT_SECONDS
# (a WARNING is logged at startup, never a refusal, if it is not).
KERDOOS_BROWSER_FETCH_TIMEOUT_SECONDS=90

# Max abandoned browser-tier fetches (their process tree could not be
# confirmed dead after SIGKILL) allowed to accumulate before new browser
# fetches are refused outright rather than launching another Chromium on
# top of an unbounded pile of stuck ones. Each refusal is logged at ERROR.
KERDOOS_BROWSER_MAX_ABANDONED_FETCHES=5

# Total deadline (seconds) on the uc tier's navigate-through-quit cycle.
# MEASURED: get_page_source/current_url/quit have no bound of their own, and
# neither does a client-side Selenium command timeout, when Chrome freezes
# after navigation -- this is a total deadline on an owner thread instead
# (mirrors KERDOOS_UC_LAUNCH_TIMEOUT_SECONDS's design for the launch phase).
# On expiry: driver.quit() is NEVER retried (it would hang identically);
# only this launch's own process tree is killed (by marker plus the exact
# uc_driver service pid), under the gate.
KERDOOS_UC_FETCH_TIMEOUT_SECONDS=90

# camoufox tier (patched Firefox, shipped in the autonomous image by
# default). No activation variable exists: the tier is used when a site
# declares it and the browser is installed, otherwise it is skipped.
# Defaults MEASURED through the adapter in a container: launch 0.4-1.8s over
# 19 launches, navigation plus the Akamai interstitial wait 2.1-15.6s. Keep
# launch + navigation < fetch < KERDOOS_BROWSER_ACQUIRE_TIMEOUT_SECONDS (a
# startup WARNING, never a refusal, says so if they are not ordered).
KERDOOS_CAMOUFOX_LAUNCH_TIMEOUT_SECONDS=20
KERDOOS_CAMOUFOX_NAV_TIMEOUT_SECONDS=45
# Covers launch, navigation and teardown, teardown including the pinning
# proxy's own join: a frozen fetch past this deadline still holds the shared
# browser gate for a bounded sweep, which is why it stays well under the
# gate acquire timeout.
KERDOOS_CAMOUFOX_FETCH_TIMEOUT_SECONDS=90

# Max times the WebUI's background run-queue consumer restarts itself after
# an unexpected crash before refusing new POST /run enqueues. 0 = no
# restart: the first crash disables "Verifier maintenant" until the process
# is restarted.
KERDOOS_RUN_QUEUE_MAX_RESTARTS=5

# Number of distinct owners simultaneously queued/running in the run_now
# queue at which an operator is warned of a backlog building up (a log
# line, plus a banner on the dashboard for admins only). 0 disables the
# warning entirely.
KERDOOS_RUN_QUEUE_BACKLOG_WARN_THRESHOLD=5

# Min seconds between one owner's run_now finishing and their next accepted
# "Verifier maintenant" click. Bounds how often a single tenant can hammer
# the shared browser gate and degrade the shared egress IP's anti-bot
# reputation for every other tenant. 0 = disabled. Enforced PER PROCESS
# (each RunQueue is process-local) -- with KERDOOS_WORKERS=N, up to N runs
# per window are possible across the N uvicorn workers.
KERDOOS_RUN_NOW_COOLDOWN_SECONDS=300
