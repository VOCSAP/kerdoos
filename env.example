# Copy to .env and fill in. Never commit .env (gitignored).

# Required: HMAC key for signed session cookies + CSRF tokens, >=32 chars.
KERDOOS_SESSION_SECRET=

# SQLite paths -- default to the Docker image's /data volume, no need to set
# these for a compose deployment.
# KERDOOS_CONFIG_DB=/data/config.db
# KERDOOS_STATE_DB=/data/state.db

# Set to "false" only for a plain-http LAN deployment (no TLS terminator).
KERDOOS_COOKIE_SECURE=true

# Real uvicorn worker count (see the Dockerfile CMD) AND the digest
# evaluator's workers>1 guard read this SAME value. Leave at 1 unless you
# have also disabled KERDOOS_DIGEST_EVALUATOR_ENABLED and switched to an
# external cron calling `kerdoos digest`.
KERDOOS_WORKERS=1
KERDOOS_DIGEST_EVALUATOR_ENABLED=true

# SMTP relay for digest emails. Leave KERDOOS_SMTP_HOST unset to fall back to
# a log-only sender (no mail actually sent). The relay itself must refuse to
# deliver to private/reserved IP ranges (RFC 1918, 127/8, 169.254/16, and the
# IPv6 equivalents) -- a stored recipient address is validated against an
# IP-literal domain, but a PUBLIC domain can still resolve to an internal IP
# (e.g. 10.0.0.1.nip.io), which no email-address validation can catch.
KERDOOS_SMTP_HOST=
KERDOOS_SMTP_PORT=587
KERDOOS_SMTP_FROM=
KERDOOS_SMTP_USERNAME=
KERDOOS_SMTP_PASSWORD=
KERDOOS_SMTP_USE_TLS=true
# Per-operation smtplib socket timeout; must stay below the reaper timeout.
KERDOOS_SMTP_TIMEOUT_SECONDS=30
# Bounded retry on a TRANSIENT send failure (e.g. greylisting), inside the
# same send() call -- never across ticks. Budget-capped by the reaper timeout.
KERDOOS_SMTP_RETRY_ATTEMPTS=2
KERDOOS_SMTP_RETRY_BACKOFF_SECONDS=2

# Max seconds a job_run may sit queued/running before the reaper reclaims it.
KERDOOS_DIGEST_REAPER_TIMEOUT_SECONDS=300

# Max Chromium processes alive at once (browser tier patchright + uc tier
# seleniumbase share ONE gate). Bounded across every process sharing the
# SAME lock directory (the WebUI/`kerdoos digest` use the directory of
# KERDOOS_STATE_DB, i.e. /data in the image; a manual `kerdoos run --db
# <path>` uses the parent of that --db path instead -- point it at /data
# too if it must share the bound with the WebUI). File lock is fcntl --
# Windows has no fcntl, so there the bound is PER PROCESS ONLY (KERDOOS_WORKERS
# x this value), not global; adjust to your machine's available RAM.
KERDOOS_BROWSER_MAX_CONCURRENT=1
# Max seconds a fetch waits for the gate above before failing as a
# (retryable) INDETERMINATE source instead of blocking forever.
KERDOOS_BROWSER_ACQUIRE_TIMEOUT_SECONDS=120

# Max times the WebUI's background run-queue consumer restarts itself after
# an unexpected crash before refusing new POST /run enqueues. 0 = no
# restart: the first crash disables "Verifier maintenant" until the process
# is restarted.
KERDOOS_RUN_QUEUE_MAX_RESTARTS=5
